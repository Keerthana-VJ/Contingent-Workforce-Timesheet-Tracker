# Supabase PostgreSQL Database Connection
# Replace with your Supabase direct / pooler connection string:
# Format: jdbc:postgresql://<db_host>:<port>/<db_name>?sslmode=require
SUPABASE_DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.xgcaubomwuyaspgwvxnq
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Application Port
PORT=8080

# JWT Authentication Secret (Minimum 256-bit / 32-character hex or string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Frontend URL for CORS (Comma-separated if multiple)
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Database Initialization Mode (never / always / embedded)
SQL_INIT_MODE=never
