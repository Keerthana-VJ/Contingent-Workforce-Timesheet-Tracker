# ==========================================
# Contingent Workforce Tracker - Frontend Environment
# ==========================================

# URL of the Spring Boot Backend API
# When backend is on another computer, set this to the backend computer's LAN IP:
# Format: http://<BACKEND_HOST_IP>:8080/api
VITE_API_URL=http://localhost:8080/api

# Set to true to use mock API instead of live backend (useful for offline UI testing)
VITE_USE_MOCK_API=false
